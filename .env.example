# BankKey HSM — Laboratory Environment
# Copy to .env and provide your own values.
# Never commit real credentials.

# PostgreSQL
BANKKEY_DB_PASSWORD=

# JWT signing secret
# Generate with:
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
BANKKEY_JWT_SECRET=

# SoftHSM2 configuration path
SOFTHSM2_CONF=

# The HSM User PIN must be entered interactively.
# Never store HSM PINs in this file.
